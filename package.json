{
  "name": "finsync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/migrate.mjs && next dev",
    "build": "node scripts/migrate.mjs && next build",
    "build:nomigrate": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
