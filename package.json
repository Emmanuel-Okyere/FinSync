    "test:paye": "node --experimental-strip-types --no-warnings scripts/test-paye.mts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@node-rs/argon2": "^2.2.1",
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "next": "16.3.8",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.5",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
