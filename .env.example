# ---- Database (Neon) -------------------------------------------------------
# Pooled connection string (used by the app).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/finsync?sslmode=require"
# Direct (unpooled) connection string, used for migrations. Optional; falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/finsync?sslmode=require"

# ---- Auth -------------------------------------------------------------------
# 32+ random bytes each. Generate with: openssl rand -base64 48
JWT_SECRET=""
# SMS one-time codes (verify phone at sign-up, "Code by SMS" sign-in, forgot password).
# Off for now: sign-up signs in straight away. Set to "true" (and set OTP_SECRET) to turn them back on.
OTP_ENABLED="false"
OTP_SECRET=""
# Public URL of the app (used in SMS links and as the Google OAuth redirect base).
APP_URL="http://localhost:3000"

# ---- GIANT SMS --------------------------------------------------------------
# Either the API token from the GIANT SMS dashboard...
GIANTSMS_TOKEN=""
# ...or your API username + secret (we build the Basic token from them).
GIANTSMS_USERNAME=""
GIANTSMS_SECRET=""
GIANTSMS_SENDER_ID="AwoshieSDA"
# Comma-separated E.164 prefixes we will send SMS to (blocks SMS-pumping fraud).
SMS_ALLOWED_PREFIXES="+233"

# ---- Legal pages ------------------------------------------------------------
# Shown on /terms and /privacy as the operator and the contact for data requests.
LEGAL_OPERATOR_NAME="FinSync"
SUPPORT_EMAIL=""

# ---- Optional ---------------------------------------------------------------
# Google sign-in (buttons are hidden when these are empty).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Protects /api/cron/daily. Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=""
